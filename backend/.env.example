# Server
PORT=4000
NODE_ENV=development

# Database — SQLite for local dev, switch to PostgreSQL in production
# For Postgres use: postgresql://user:password@localhost:5432/bisstech?schema=public
DATABASE_URL="file:./dev.db"

# Auth
JWT_SECRET=change_this_to_a_strong_random_string_at_least_32_chars
JWT_REFRESH_SECRET=change_this_refresh_secret_also_strong
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS — comma separated allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Frontend URL (for CORS + email links)
FRONTEND_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174

# Email — Resend (primary for OTP delivery)
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@bisstech.com
RESEND_FROM_NAME=BISSTECH

# Email — SMTP fallback (Gmail SMTP — optional if Resend is configured)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=BISSTECH
SMTP_FROM_EMAIL=noreply@bisstech.com
ADMIN_NOTIFY_EMAIL=info.bisstech@gmail.com

# Uploads — local folder or S3-compatible
UPLOAD_DIR=./uploads
# For S3 later: S3_BUCKET, S3_REGION, S3_ACCESS_KEY, S3_SECRET_KEY

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
