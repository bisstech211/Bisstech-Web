generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ── Auth & Users ──────────────────────────────────────────────
model User {
  id            String     @id @default(cuid())
  email         String     @unique
  passwordHash  String
  name          String
  role          String     @default("EDITOR")
  isActive      Boolean    @default(true)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  auditLogs     AuditLog[]
  leadsAssigned Lead[]
}

// ── Site Settings (single row, upsert) ───────────────────────
model SiteSettings {
  id              String   @id @default("site")
  siteName        String   @default("BISSTECH")
  tagline         String   @default("Build. Grow. Automate.")
  description     String   @default("")
  logoUrl         String?
  faviconUrl      String?
  contactEmail    String   @default("info.bisstech@gmail.com")
  contactPhone    String?
  whatsapp        String?
  whatsappDisplay String?
  address         String?
  businessHours   String?
  mapEmbedUrl     String?
  updatedAt       DateTime @updatedAt
}

model SocialLinks {
  id        String  @id @default(cuid())
  platform  String // instagram, linkedin, facebook, youtube, twitter
  url       String
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)
}

model NavigationMenu {
  id        String           @id @default(cuid())
  label     String
  path      String
  sortOrder Int              @default(0)
  isActive  Boolean          @default(true)
  parentId  String?
  parent    NavigationMenu?  @relation("MenuChildren", fields: [parentId], references: [id])
  children  NavigationMenu[] @relation("MenuChildren")
}

model FooterSettings {
  id          String   @id @default("footer")
  description String   @default("")
  copyright   String   @default("© BISSTECH. All rights reserved.")
  updatedAt   DateTime @updatedAt
}

// ── Pages & Sections ─────────────────────────────────────────
model Page {
  id             String        @id @default(cuid())
  slug           String        @unique // home, about, services, contact
  title          String
  description    String?
  isPublished    Boolean       @default(true)
  seoTitle       String?
  seoDescription String?
  ogImage        String?
  canonicalUrl   String?
  sections       PageSection[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

model PageSection {
  id        String  @id @default(cuid())
  pageId    String
  page      Page    @relation(fields: [pageId], references: [id], onDelete: Cascade)
  key       String // hero, about, stats, whyUs, process, portfolio, testimonials, cta, faq
  title     String?
  subtitle  String?
  content   String? // JSON string for flexible structured content
  imageUrl  String?
  ctaLabel  String?
  ctaLink   String?
  sortOrder Int     @default(0)
  isVisible Boolean @default(true)
}

// ── Services ─────────────────────────────────────────────────
model Service {
  id             String           @id @default(cuid())
  slug           String           @unique
  title          String
  shortDesc      String?
  description    String?
  icon           String? // lucide icon name
  imageUrl       String?
  sortOrder      Int              @default(0)
  isPublished    Boolean          @default(true)
  seoTitle       String?
  seoDescription String?
  features       ServiceFeature[]
  faqs           ServiceFaq[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
}

model ServiceFeature {
  id         String  @id @default(cuid())
  serviceId  String
  service    Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  groupTitle String
  items      String // JSON array string
  sortOrder  Int     @default(0)
}

model ServiceFaq {
  id        String  @id @default(cuid())
  serviceId String
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  question  String
  answer    String
  sortOrder Int     @default(0)
}

// ── Portfolio / Projects ─────────────────────────────────────
model Project {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String?
  imageUrl    String?
  link        String?
  category    String?
  sortOrder   Int      @default(0)
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Testimonial {
  id          String  @id @default(cuid())
  name        String
  role        String?
  company     String?
  content     String
  avatarUrl   String?
  rating      Int     @default(5)
  sortOrder   Int     @default(0)
  isPublished Boolean @default(true)
}

model TeamMember {
  id        String  @id @default(cuid())
  name      String
  role      String
  bio       String?
  avatarUrl String?
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)
}

model Faq {
  id          String  @id @default(cuid())
  question    String
  answer      String
  sortOrder   Int     @default(0)
  isPublished Boolean @default(true)
}

// ── Blog ─────────────────────────────────────────────────────
model BlogCategory {
  id    String     @id @default(cuid())
  name  String     @unique
  slug  String     @unique
  posts BlogPost[]
}

model BlogTag {
  id    String     @id @default(cuid())
  name  String     @unique
  slug  String     @unique
  posts BlogPost[] @relation("PostTags")
}

model BlogPost {
  id             String        @id @default(cuid())
  slug           String        @unique
  title          String
  excerpt        String?
  content        String // HTML string
  featuredImage  String?
  author         String        @default("BISSTECH Team")
  categoryId     String?
  category       BlogCategory? @relation(fields: [categoryId], references: [id])
  tags           BlogTag[]     @relation("PostTags")
  status         String        @default("DRAFT")
  featured       Boolean       @default(false)
  seoTitle       String?
  seoDescription String?
  ogImage        String?
  canonicalUrl   String?
  publishedAt    DateTime?
  readingTime    String?
  viewCount      Int           @default(0)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

// ── Leads & Newsletter ───────────────────────────────────────
model Lead {
  id           String    @id @default(cuid())
  name         String
  email        String
  phone        String?
  company      String?
  service      String?
  budget       String?
  message      String?
  source       String?
  landingPage  String?
  utmSource    String?
  utmMedium    String?
  utmCampaign  String?
  utmTerm      String?
  utmContent   String?
  referrer     String?
  status       String    @default("NEW")
  notes        String?
  assignedToId String?
  assignedTo   User?     @relation(fields: [assignedToId], references: [id])
  followUpAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  status    String   @default("active") // active, unsubscribed
  createdAt DateTime @default(now())
}

// ── Media ────────────────────────────────────────────────────
model Media {
  id           String   @id @default(cuid())
  filename     String
  originalName String
  mimeType     String
  size         Int
  url          String
  altText      String?
  caption      String?
  folder       String?  @default("general")
  createdAt    DateTime @default(now())
}

// ── SEO & Redirects & Tracking ───────────────────────────────
model SeoSettings {
  id                 String   @id @default("seo")
  defaultTitle       String   @default("BISSTECH — Build. Grow. Automate.")
  defaultDescription String   @default("")
  defaultOgImage     String?
  robotsTxt          String   @default("User-agent: *\nAllow: /")
  faviconUrl         String?
  updatedAt          DateTime @updatedAt
}

model Redirect {
  id         String  @id @default(cuid())
  from       String  @unique
  to         String
  statusCode Int     @default(301)
  isActive   Boolean @default(true)
}

model TrackingSettings {
  id               String   @id @default("tracking")
  gaMeasurementId  String?
  gaEnabled        Boolean  @default(false)
  gtmContainerId   String?
  gtmEnabled       Boolean  @default(false)
  metaPixelId      String?
  metaPixelEnabled Boolean  @default(false)
  clarityId        String?
  clarityEnabled   Boolean  @default(false)
  gscVerification  String?
  updatedAt        DateTime @updatedAt
}

model IntegrationSettings {
  id        String   @id @default(cuid())
  provider  String   @unique // smtp, resend, cloudinary, etc.
  config    String // JSON string, encrypted at app layer if needed
  isEnabled Boolean  @default(false)
  updatedAt DateTime @updatedAt
}

model Webhook {
  id        String   @id @default(cuid())
  url       String
  secret    String?
  event     String // lead.created, subscriber.created, blog.published
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model WebhookLog {
  id         String   @id @default(cuid())
  webhookId  String
  event      String
  payload    String
  statusCode Int?
  response   String?
  success    Boolean
  createdAt  DateTime @default(now())
}

// ── Audit & System ───────────────────────────────────────────
model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String // create, update, delete, login
  resource   String // blog, service, lead, settings
  resourceId String?
  metadata   String? // JSON
  ip         String?
  createdAt  DateTime @default(now())
}

model ApiKey {
  id        String   @id @default(cuid())
  name      String
  key       String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

// ── Password Reset OTP ───────────────────────────────────────
model PasswordResetOtp {
  id        String   @id @default(cuid())
  email     String
  otpHash   String
  expiresAt DateTime
  attempts  Int      @default(0)
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email])
  @@index([expiresAt])
}
